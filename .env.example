# ==============================================================================
# LAGOS STATE CIVIL SERVICE COMMISSION CBT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# 2. Project Service Role Key (secret key, gives full server-side access to database tables)
SUPABASE_SERVICE_ROLE_KEY=

# (Optional fallback key if you use anon key instead)
# SUPABASE_ANON_KEY=

# Administrator Password (for username: admin)
ADMIN_PASSWORD=admin2027

# Server Port (default 3001)
PORT=3001
